    "Color shows dew point comfort through the day." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe zeigt das Feuchtigkeitsempfinden im Tagesverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color muestra la sensación de humedad a lo largo del día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur indique le confort lié au point de rosée au fil de la journée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor mostra a sensação de umidade ao longo do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет показывает ощущение влажности в течение дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色显示一天中露点舒适程度的变化。"
          }
        }
      }
    },
    "Color shows temperature through the day." : {
      "extractionState" : "manual",
      "localizations" : {
