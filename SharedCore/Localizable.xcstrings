    "JustDew keeps dew point, comfort ranges, and forecasts close at hand, with saved locations and widgets for Mac, iPhone, and Apple Watch." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew hält Taupunkt, Komfortbereiche und Vorhersagen griffbereit, mit gespeicherten Standorten und Widgets für Mac, iPhone und Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew pone a tu alcance el punto de rocío, los rangos de comodidad y los pronósticos, con ubicaciones guardadas y widgets para Mac, iPhone y Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew garde le point de rosée, les plages de confort et les prévisions à portée de main, avec des lieux enregistrés et des widgets pour Mac, iPhone et Apple Watch."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O JustDew mantém o ponto de orvalho, as faixas de conforto e as previsões à mão, com localizações salvas e widgets para Mac, iPhone e Apple Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew показывает точку росы, диапазоны комфорта и прогнозы, с сохранёнными местами и виджетами для Mac, iPhone и Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew 让你随时查看露点、舒适范围和预报，并提供适用于 Mac、iPhone 和 Apple Watch 的已保存位置及小组件。"
          }
        }
      }
    },
    "JustDew uses your location to show the local dew point." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew verwendet deinen Standort, um den örtlichen Taupunkt anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew usa tu ubicación para mostrar el punto de rocío local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew utilise votre position pour afficher le point de rosée local."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O JustDew usa sua localização para mostrar o ponto de orvalho local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew использует вашу геопозицию, чтобы показывать местную точку росы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JustDew 使用你的位置来显示当地露点。"
          }
        }
      }
    },
    "Keep a saved city's weather on your watch face or in the Smart Stack." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wetter einer gespeicherten Stadt auf dem Zifferblatt oder im Smart-Stapel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten el tiempo de una ciudad guardada en la esfera del reloj o la Pila Inteligente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez la météo d’une ville enregistrée sur votre cadran ou dans la pile intelligente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o tempo de uma cidade salva no mostrador ou no Conjunto Inteligente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Погода сохранённого города на циферблате или в Смарт-стопке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在表盘或智能叠放中查看已保存城市的天气。"
          }
        }
      }
    },
