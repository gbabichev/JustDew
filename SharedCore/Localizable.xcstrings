    },
    "Colors blend gradually across this scale; they are not hard comfort cutoffs." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farben gehen fließend ineinander über und sind keine festen Komfortgrenzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores cambian gradualmente; no son límites estrictos de comodidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs évoluent progressivement et ne définissent pas des seuils stricts de confort."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores mudam gradualmente e não representam limites rígidos de conforto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвета плавно переходят друг в друга и не обозначают строгих границ комфорта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色在此范围内逐渐变化，并非严格的舒适度分界。"
          }
        }
      }
    },
