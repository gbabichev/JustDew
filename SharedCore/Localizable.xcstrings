    "Higher dew points mean more moisture in the air and generally feel muggier." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein höherer Taupunkt bedeutet mehr Feuchtigkeit in der Luft und fühlt sich meist schwüler an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un punto de rocío más alto indica más humedad en el aire y suele sentirse más bochornoso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un point de rosée plus élevé indique davantage d’humidité et donne généralement une sensation d’air plus lourd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ponto de orvalho mais alto indica mais umidade no ar e geralmente uma sensação mais abafada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем выше точка росы, тем больше влаги в воздухе и тем сильнее ощущается духота."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "露点越高，空气中的水分越多，通常会感觉更闷热潮湿。"
          }
        }
      }
    },
