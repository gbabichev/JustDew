    "WeatherKit setup is incomplete for this bundle ID. In Apple Developer Identifiers, enable WeatherKit in App Services and App Capabilities, then clean and rebuild." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die WeatherKit-Einrichtung für diese Bundle-ID ist unvollständig. Aktiviere WeatherKit unter Apple Developer Identifiers in App Services und App Capabilities und bereinige und erstelle das Projekt neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de WeatherKit está incompleta para este identificador de paquete. En Identificadores de Apple Developer, activa WeatherKit en App Services y App Capabilities; después limpia y vuelve a compilar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration de WeatherKit est incomplète pour cet identifiant de bundle. Dans Apple Developer Identifiers, activez WeatherKit dans App Services et App Capabilities, puis nettoyez et recompilez."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração do WeatherKit está incompleta para este identificador de pacote. Em Apple Developer Identifiers, ative o WeatherKit em App Services e App Capabilities; depois limpe e compile novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройка WeatherKit для этого идентификатора пакета не завершена. В Apple Developer Identifiers включите WeatherKit в App Services и App Capabilities, затем очистите и пересоберите проект."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此包标识的 WeatherKit 设置不完整。请在 Apple Developer Identifiers 的 App Services 和 App Capabilities 中启用 WeatherKit，然后清理并重新构建。"
          }
        }
      }
    },
