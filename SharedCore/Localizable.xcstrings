    "Location lookup failed. Weather was updated for your last known location.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location lookup failed. Weather was updated for your last known location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener tu ubicación. El tiempo se actualizó para tu última ubicación conocida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить местоположение. Погода обновлена для последнего известного местоположения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取位置。已更新上次已知位置的天气。"
