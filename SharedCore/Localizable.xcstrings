        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point de rosée est la température à laquelle l’air devient saturé. Il aide à décrire la quantité d’humidité dans l’air."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ponto de orvalho é a temperatura em que o ar fica saturado. Ele ajuda a descrever a quantidade de umidade no ar."
