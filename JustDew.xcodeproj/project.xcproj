{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "JustDew",
      "target-membership": [
        "JustDew",
      ],
      "membership-exceptions": [
        {
          "target": "JustDewWatch Watch App",
          "inclusions": [
            "JustDewIcon.icon",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "JustDewWidget",
      "target-membership": [
        "JustDewWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "JustDewWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "JustDewWatch Watch App", "target-membership": [ "JustDewWatch Watch App" ] },
    {
      "kind": "folder",
      "path": "JustDewWatch",
      "target-membership": [
        "JustDewWatchExtension",
      ],
      "membership-exceptions": [
        {
          "target": "JustDewWatchExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "SharedCore", "target-membership": [ "JustDew", "JustDewWatch Watch App", "JustDewWatchExtension", "JustDewWidgetExtension" ] },
    { "kind": "folder", "path": "SharedApp", "target-membership": [ "JustDew", "JustDewWatch Watch App" ] },
    { "kind": "folder", "path": "Config" },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "JustDewWidgetExtension/frameworks",
            "JustDewWatchExtension/frameworks",
          ],
        }, {
          "path": "/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "JustDewWidgetExtension/frameworks",
            "JustDewWatchExtension/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/JustDew.app", "id": "FF3EA94D2FBB5992000CF230", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/JustDewWidgetExtension.appex", "id": "FF3EA95F2FBB5B24000CF230", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "JustDew/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/JustDewWatch Watch App.app", "id": "FF3EA97B2FBB5B4E000CF230", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "JustDew/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/JustDewWatchExtension.appex", "id": "FF3EA98E2FBB5B60000CF230", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "JustDewWatch Watch App/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "JustDew",
      "id": "FF3EA94C2FBB5992000CF230",
      "product": "Products/JustDew.app",
      "product-type": "application",
      "dependencies": [
        "JustDewWidgetExtension",
        { "target": "JustDewWatch Watch App", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "JustDewIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/JustDew.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Config/JustDew-macOS.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "6",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "7GK58M2353",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.weather",
        "INFOPLIST_KEY_NSLocationUsageDescription": "JustDew uses your location to show the local dew point.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "JustDew uses your location to show the local dew point.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "2.0.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.georgebabichev.JustDew",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "XROS_DEPLOYMENT_TARGET": "26.5",
      },
    }, {
      "name": "JustDewWidgetExtension",
